# Project URL Supabase, contoh: https://project-id.supabase.co
# Jangan isi dengan database URL postgresql://...
VITE_SUPABASE_URL=

# Gunakan anon public key Supabase. Jangan gunakan service role key.
VITE_SUPABASE_ANON_KEY=

# AI real hanya lewat Supabase Edge Function proxy. Jangan buat VITE_AI_API_KEY.
VITE_AI_PROXY_URL=
VITE_AI_MODE=mock
VITE_AI_MONTHLY_BUDGET=10
VITE_OCR_MODE=mock
